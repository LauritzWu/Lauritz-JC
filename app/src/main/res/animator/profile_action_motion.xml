<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.94" android:valueType="floatType" android:duration="120" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.94" android:valueType="floatType" android:duration="120" />
        </set>
    </item>
    <item android:state_hovered="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.06" android:valueType="floatType" android:duration="120" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.06" android:valueType="floatType" android:duration="120" />
        </set>
    </item>
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.06" android:valueType="floatType" android:duration="120" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.06" android:valueType="floatType" android:duration="120" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:valueType="floatType" android:duration="120" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:valueType="floatType" android:duration="120" />
        </set>
    </item>
</selector>
