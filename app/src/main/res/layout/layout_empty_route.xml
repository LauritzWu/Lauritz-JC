<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/card_list_item_margin_horizontal"
    android:layout_marginEnd="@dimen/card_list_item_margin_horizontal"
    android:layout_marginTop="@dimen/card_list_item_margin_vertical"
    android:layout_marginBottom="@dimen/card_list_item_margin_vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?android:attr/textColorPrimary"
            android:lineSpacingExtra="3dp"
            android:text="@string/custom_route_notice"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>